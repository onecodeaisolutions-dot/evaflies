# Copie para .env e preencha. NUNCA comite o .env com a chave real.

# Obrigatória: sua chave da OpenAI
OPENAI_API_KEY=sk-...

# Porta do servidor
PORT=3000

# Modelo de transcrição: gpt-4o-transcribe | gpt-4o-mini-transcribe | whisper-1
TRANSCRIBE_MODEL=gpt-4o-transcribe

# Modelo usado para gerar resumo / action items
SUMMARY_MODEL=gpt-4o-mini

# Idioma esperado da fala (ISO-639-1). Ex: pt, en, es
TRANSCRIBE_LANGUAGE=pt

# Origem permitida para CORS (a extensão usa origem chrome-extension://...).
# Deixe * para permitir qualquer origem em desenvolvimento.
CORS_ORIGIN=*
