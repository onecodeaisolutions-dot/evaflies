{
  "manifest_version": 3,
  "name": "EvaFlies — Gravador & Transcrição de Reuniões",
  "version": "1.0.2",
  "description": "Grava o áudio da reunião (aba + microfone) e gera transcrição completa com a API da OpenAI.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EvaFlies",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
